# Used ONLY by the automated test suite (node --env-file=.env.test --test ...).
# Points at a SEPARATE database from normal development -- the test suite
# truncates its tables between test files, so this must never point at
# the same database as your regular .env. A safety check in
# tests/helpers/setup.ts refuses to run unless this database name
# contains "test".
DATABASE_URL=postgres://onway:onway@localhost:5433/onway_test
NODE_ENV=test
PORT=3001
JWT_SECRET=test-only-secret-do-not-use-in-production-1234567890
JWT_EXPIRES_IN=1h
