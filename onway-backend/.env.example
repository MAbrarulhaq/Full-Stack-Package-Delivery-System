DATABASE_URL=postgres://user:password@localhost:5432/onway
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-freshly-generated-32-byte-random-secret
JWT_EXPIRES_IN=1d
# Deployed frontend origin, required in production for CORS.
# Leave unset for local dev — http://localhost:5173 is always allowed.
FRONTEND_URL=https://<your-vercel-domain>
